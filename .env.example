# Resend API Key for contact form submission (/api/contact)
RESEND_API_KEY=your_resend_api_key_here

# Recipient email address where contact form submissions will be forwarded
CONTACT_EMAIL=your_email_here@example.com

# Sender display name and email (must be a verified domain or onboarding@resend.dev)
FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
